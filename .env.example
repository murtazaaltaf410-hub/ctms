# CTMS V1 environment variables. Copy to server/.env for local development.
# Never commit real values. Hosted envs (staging/production) set these in the
# host dashboard (runbook p.1).

# ---------------------------------------------------------------------------
# server (FastAPI) — Phase 2
# ---------------------------------------------------------------------------
# dev | test | staging | production. Outside dev/test the server refuses to
# start unless every secret below is set (fail fast).
APP_ENV=dev
# Local: docker compose -f docker-compose.dev.yml up -d (host port 55432).
# Supabase: the Shared pooler, SESSION mode, port 5432 (ADR-2).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ctms
# Only for the test suite (no demo data).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ctms_test
# Long random value, different per environment (>= 32 chars outside dev).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated Google OAuth client IDs whose ID tokens are accepted
# (put the Web client ID used as serverClientId in the app).
GOOGLE_OAUTH_CLIENT_IDS=
# Firebase service account: inline JSON or a file path (FCM push, Firebase OTP).
FCM_CREDENTIALS=
# Server-only key with the Routes API enabled (ADR-8).
GOOGLE_DIRECTIONS_KEY=
# First admin's Google email (also honoured in addition to admin_allowlist).
SEED_ADMIN_EMAIL=warisrawa145@gmail.com
# Fallback only; the `settings` table (PUT /admin/settings) wins.
ALERT_RADIUS_M=500
# Driver OTP provider (ADR-7): console (dev default, logs the code) | firebase.
# Must be set, and must not be console, outside dev/test.
OTP_PROVIDER=console
# true behind Render/Railway so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false
# Browser origin allow-list (CORS + WebSocket Origin), comma-separated, never "*".
# Empty in dev/test = http://localhost:5173. Required for the web PWA in staging/production.
# CORS_ORIGINS=https://staging.example.com
# HSTS_MAX_AGE_S=31536000   (HSTS is sent only when APP_ENV=production)
# Set to 0 only if you must use Supabase's transaction pooler (port 6543).
# DB_STATEMENT_CACHE_SIZE=0
# Any threshold in the `settings` table can also be given here as a fallback,
# e.g. OTP_TTL_SECONDS=300, STALE_AFTER_S=30 (env name = key in upper case).
